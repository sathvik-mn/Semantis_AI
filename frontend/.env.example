# Supabase (from your Supabase project dashboard)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Backend URL
VITE_BACKEND_URL=http://localhost:8000

# Admin API Key (must match ADMIN_API_KEY in backend .env)
VITE_ADMIN_API_KEY=

# Sentry (optional — error tracking disabled if not set)
VITE_SENTRY_DSN=

# PostHog (optional — product analytics disabled if not set)
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

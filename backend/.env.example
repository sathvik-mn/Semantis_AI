# ── Required ──

# Your fallback OpenAI API key (used when user hasn't set their own)
OPENAI_API_KEY=sk-your-openai-api-key

# Supabase — Get these from your Supabase project dashboard
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
SUPABASE_URL=https://[PROJECT_REF].supabase.co

# Encryption key for OpenAI API keys at rest
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Random salt for key derivation (hex string). Generate once per deployment:
# python -c "import os; print(os.urandom(16).hex())"
ENCRYPTION_SALT=

# ── Authentication ──

# Legacy JWT secret (optional — only needed if you haven't migrated to new JWT Signing Keys)
# The backend auto-discovers the public key from SUPABASE_URL via JWKS for ES256/RS256 keys.
# You can get this from: Supabase Dashboard > Settings > JWT Keys > Legacy JWT Secret > Reveal
SUPABASE_JWT_SECRET=

# ── Stripe Billing (optional — billing disabled if not set) ──

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=price_xxxxx
STRIPE_PRICE_TEAM=price_xxxxx

# ── Admin ──

# Secret key for /admin/* endpoints. Leave empty to disable admin API.
ADMIN_API_KEY=

# ── CORS ──

# Comma-separated origins. Defaults to localhost:3000,localhost:5173 if unset.
# For production: https://yourdomain.com
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Frontend URL (for billing redirect URLs) ──

# Set to your production frontend URL. Used for Stripe checkout success/cancel redirects.
# Example: https://app.semantis.ai
FRONTEND_URL=http://localhost:5173

# ── Redis (optional — in-memory cache used if not set) ──
# For Upstash: rediss://default:YOUR_PASSWORD@YOUR_ENDPOINT.upstash.io:6379
REDIS_URL=redis://localhost:6379/0

# ── Vector Store (optional — FAISS fallback if not set) ──
# Create an index at pinecone.io with cosine metric and 1024 dimensions
PINECONE_API_KEY=
PINECONE_INDEX_NAME=semantis-cache
PINECONE_HOST=

# ── Error Tracking (optional) ──
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
ENVIRONMENT=development

# ── Email (optional — emails disabled if not set) ──
RESEND_API_KEY=
FROM_EMAIL=Semantis AI <noreply@semantis.ai>

# ── Logging ──
# Set to "json" for structured JSON logs (production), "text" for human-readable (dev)
LOG_FORMAT=text

# ── Database Pool ──
DB_MAX_CONNECTIONS=25

# ── Server ──

PORT=8000

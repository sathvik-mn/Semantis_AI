# Copy to secrets.yml and fill in real values (base64 encoded)
# echo -n "your-value" | base64
apiVersion: v1
kind: Secret
metadata:
  name: semantys-secrets
  namespace: semantys
type: Opaque
data:
  OPENAI_API_KEY: ""          # base64 encoded
  DATABASE_URL: ""             # base64 encoded
  SUPABASE_URL: ""             # base64 encoded
  SUPABASE_JWT_SECRET: ""      # base64 encoded
  ENCRYPTION_KEY: ""           # base64 encoded
  STRIPE_SECRET_KEY: ""        # base64 encoded
  STRIPE_WEBHOOK_SECRET: ""    # base64 encoded
  STRIPE_PRICE_PRO: ""         # base64 encoded
  STRIPE_PRICE_TEAM: ""        # base64 encoded
  ADMIN_API_KEY: ""            # base64 encoded
